<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 分享链接标题抓取：解析不出店名时后台读取链接网页标题自动补名。
         普通权限（安装即授予）；仅请求 https 链接，失败静默回退手动填写。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Stage 3.2：平台快捷承接所需的包可见性
         Android 11+ 需显式声明才能通过 PackageManager 查询大众点评/美团是否已安装。
         仅声明确有必要的平台包，不申请任何运行时权限。 -->
    <queries>
        <!-- 大众点评 -->
        <package android:name="com.dianping.v1" />
        <!-- 美团 -->
        <package android:name="com.sankuai.meituan" />
    </queries>

    <application
        android:name=".What2EatApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.What2Eat"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.What2Eat">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Stage 5：接收外部分享文本（text/plain） -->
        <activity
            android:name=".ShareImportActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.What2Eat"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- v1.1.0：美团登录页（可选，提升店名抓取成功率；不导出，仅 App 内跳转） -->
        <activity
            android:name=".MeituanLoginActivity"
            android:exported="false"
            android:label="美团登录"
            android:theme="@style/Theme.What2Eat" />

        <!-- v1.2.3：yoda 验证墙人工通过页（全屏默认 UA 环境；不导出，仅 App 内跳转） -->
        <activity
            android:name=".VerifyPassActivity"
            android:exported="false"
            android:label="美团验证"
            android:theme="@style/Theme.What2Eat" />
    </application>

</manifest>
